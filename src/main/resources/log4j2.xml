<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Lambda name="Lambda">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%p] %c{1} - %m%n</pattern>
            </PatternLayout>
        </Lambda>
    </Appenders>
    <Loggers>
        <Logger name="org.example" level="INFO"/>
        <Root level="WARN">
            <AppenderRef ref="Lambda"/>
        </Root>
    </Loggers>
</Configuration>